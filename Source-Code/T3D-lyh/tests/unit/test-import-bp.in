[grid]
  N_radial = 9
  rho_edge = 0.8
  flux_label = "rminor"

[import]
  type = "t3d"
  file = "tests/regression/ref-jet-relu.bp"
  frame = -1

[[species]]
type = "deuterium"
density = {evolve = false} # will be set by quasineutrality
temperature = {import = true, evolve = true}

[[species]]
type = "electron"
density = {import = true, evolve = false}
temperature = {import = true, evolve = true}

[geometry]
  geo_option = "basic"
  AspectRatio = 4.0

[rescale]
  a_minor = 1.0
  Ba = 2.5
